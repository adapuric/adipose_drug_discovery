#!/bin/bash
#PBS -N run_tahoe_baselines
#PBS -l select=1:ncpus=32:mem=128gb
#PBS -l walltime=72:00:00
#PBS -m a
#PBS -j oe
#PBS -o /rds/general/user/sho3/projects/lms-scott-raw/live/steve/add/job_out

# Cache all Tahoe plates and run the three Tahoe-based baseline models.
#
# Submit after prepare_rescue.pbs succeeds:
#   qsub run_scripts/baselines/pbs/run_tahoe.pbs

set -o errexit
set -o nounset
set -o pipefail

# Paths
ROOT="/rds/general/user/sho3/projects/lms-scott-raw/live/steve"
PROJECT_DIR="${ROOT}/add"
REPO_DIR="${PROJECT_DIR}/adipose_drug_discovery"
DATA_DIR="${PROJECT_DIR}/data"
TAHOE_DIR="${TAHOE_DIR:-${DATA_DIR}/tahoe}"
OUTPUT_DIR="${PROJECT_DIR}/baselines"
CONFIG_PATH="${CONFIG_PATH:-${REPO_DIR}/config/baselines.yaml}"
PSEUDOBULK_PATH="${OUTPUT_DIR}/pseudobulk/adipose_pseudobulk.h5ad"
RESCUE_PATH="${OUTPUT_DIR}/rescue/rescue_vectors.csv.gz"
SIGNATURE_PREFIX="${OUTPUT_DIR}/perturb/tahoe_signatures"

# Conda and workers
CONDA_BASE="${ROOT}/software/conda/base"
CONDA_ENV="${ROOT}/software/envs/add"
ALLOCATED_CPUS="${PBS_NCPUS:-32}"
WORKERS="${WORKERS:-$((ALLOCATED_CPUS > 1 ? ALLOCATED_CPUS - 1 : 1))}"

# PBS logging
PBS_COMMON="/rds/general/user/sho3/home/pbs_common.sh"
LOG_DIR="${PROJECT_DIR}/job_out"
JOB_NAME="${PBS_JOBNAME:-run_tahoe_baselines}"
JOB_ID="${PBS_JOBID:-local}"
LIVE_LOG="${LOG_DIR}/${JOB_NAME}.${JOB_ID}.live.log"

#######################################
# Print and run one workflow stage.
# Arguments:
#   $1: Human-readable stage name.
#   Remaining arguments: Command and arguments to execute.
# Outputs:
#   Writes the stage name and shell-escaped command to stdout.
# Returns:
#   The executed command's exit status.
#######################################
run_stage() {
  local stage_name="$1"
  shift

  printf 'Stage: %s\n' "${stage_name}"
  printf 'Command:'
  printf ' %q' "$@"
  printf '\n'
  "$@"
}

#######################################
# Validate inputs, activate the environment, and run Tahoe baselines.
# Outputs:
#   Writes job context and workflow output to stdout and stderr.
# Returns:
#   0 on success; 2 for invalid job settings; otherwise the failing command's
#   exit status.
#######################################
main() {
  local baseline_command=()
  local job_tmp="${TMPDIR:-/tmp}/${USER}/add_${JOB_ID}"
  local model=""
  local perturb_command=(
    add --config "${CONFIG_PATH}" perturb
    --source tahoe
    --input "${TAHOE_DIR}"
    --output-prefix "${SIGNATURE_PREFIX}"
  )
  local tahoe_files=(
    "${TAHOE_DIR}"/plate*_filt_Vevo_Tahoe100M_WServicesFrom_ParseGigalab.h5ad
  )

  if [[ ! -d "${REPO_DIR}" ]]; then
    printf 'ERROR: repository directory does not exist: %s\n' \
      "${REPO_DIR}" >&2
    return 2
  fi
  if [[ ! -f "${CONFIG_PATH}" ]]; then
    printf 'ERROR: baseline config does not exist: %s\n' \
      "${CONFIG_PATH}" >&2
    return 2
  fi
  if [[ ! -f "${tahoe_files[0]}" ]]; then
    printf 'ERROR: Tahoe directory contains no downloaded plates: %s\n' \
      "${TAHOE_DIR}" >&2
    return 2
  fi
  if [[ ! -f "${PSEUDOBULK_PATH}" ]]; then
    printf 'ERROR: pseudobulk input does not exist: %s\n' \
      "${PSEUDOBULK_PATH}" >&2
    return 2
  fi
  if [[ ! -f "${RESCUE_PATH}" ]]; then
    printf 'ERROR: rescue input does not exist: %s\n' "${RESCUE_PATH}" >&2
    return 2
  fi
  if [[ ! "${WORKERS}" =~ ^[1-9][0-9]*$ ]]; then
    printf 'ERROR: WORKERS must be a positive integer, got %s\n' \
      "${WORKERS}" >&2
    return 2
  fi
  if [[ ! -f "${PBS_COMMON}" ]]; then
    printf 'ERROR: PBS helper does not exist: %s\n' "${PBS_COMMON}" >&2
    return 2
  fi

  mkdir -p "${LOG_DIR}" "${OUTPUT_DIR}/perturb" \
    "${job_tmp}/matplotlib"
  source "${PBS_COMMON}"
  pbs::setup_logging "${LIVE_LOG}"
  pbs::activate_conda_environment "${CONDA_BASE}" "${CONDA_ENV}"
  pbs::log_job_context "${JOB_ID}" "${PROJECT_DIR}" "${LIVE_LOG}"

  if ! command -v add >/dev/null; then
    printf 'ERROR: add CLI is not installed in %s\n' "${CONDA_ENV}" >&2
    return 2
  fi

  cd "${REPO_DIR}"
  export MPLCONFIGDIR="${job_tmp}/matplotlib"
  export PYTHONUNBUFFERED=1

  printf 'Config: %s\n' "${CONFIG_PATH}"
  printf 'Tahoe input: %s (%d plates)\n' \
    "${TAHOE_DIR}" "${#tahoe_files[@]}"
  printf 'Output root: %s\n' "${OUTPUT_DIR}"
  printf 'Worker processes: %s\n' "${WORKERS}"
  run_stage "cache Tahoe perturbation signatures" \
    "${perturb_command[@]}"

  for model in perturbed-mean pca-ridge mean-drug; do
    baseline_command=(
      add --config "${CONFIG_PATH}" baseline
      --model "${model}"
      --signatures "${SIGNATURE_PREFIX}"
      --rescue "${RESCUE_PATH}"
      --pseudobulk "${PSEUDOBULK_PATH}"
      --output-dir "${OUTPUT_DIR}/${model}"
      --workers "${WORKERS}"
    )
    run_stage "run ${model} baseline" "${baseline_command[@]}"
  done

  printf 'Job finished: %s\n' "$(date -Is)"
}

main "$@"
