#!/bin/bash
#PBS -N baseline_report
#PBS -l select=1:ncpus=4:mem=64gb
#PBS -l walltime=24:00:00
#PBS -m a
#PBS -j oe
#PBS -o /rds/general/user/sho3/projects/lms-scott-raw/live/steve/add/job_out

# Run one CPU-only baseline report: the donor-held-out surgery transition
# benchmark, the human adipose compound panel, the PerturbGen report with
# naive edit baselines, or the rescue-program decomposition.
#
# Submit after prepare_rescue.pbs succeeds; REPORT is required:
#   qsub -v REPORT=transition run_scripts/baselines/run_report.pbs
#   qsub -v REPORT=panel,CONFIG_PATH=/abs/adipose_validation.yaml \
#     run_scripts/baselines/run_report.pbs
#   qsub -v REPORT=perturbgen,CONFIG_PATH=/abs/perturbgen_visualization.yaml \
#     run_scripts/baselines/run_report.pbs
#   qsub -l select=1:ncpus=4:mem=256gb \
#     -v REPORT=programs,CONFIG_PATH=/abs/rescue_programs.yaml \
#     run_scripts/baselines/run_report.pbs
#
# DRY_RUN=1 validates inputs without writing. Each job writes to a fresh
# REPORT_DIR (default baselines/reports/<REPORT>/<job id>).

set -o errexit
set -o nounset
set -o pipefail

# Paths
ROOT="/rds/general/user/sho3/projects/lms-scott-raw/live/steve"
PROJECT_DIR="${ROOT}/add"
REPO_DIR="${PROJECT_DIR}/adipose_drug_discovery"
OUTPUT_DIR="${PROJECT_DIR}/baselines"

# Conda
CONDA_BASE="${ROOT}/software/conda/base"
CONDA_ENV="${ROOT}/software/envs/perturbgen"

# qsub -v parameters
REPORT="${REPORT:-}"
CONFIG_PATH="${CONFIG_PATH:-}"
PSEUDOBULK_PATH="${PSEUDOBULK_PATH:-${OUTPUT_DIR}/pseudobulk/adipose_pseudobulk.h5ad}"
DRY_RUN="${DRY_RUN:-0}"

# PBS logging
PBS_COMMON="/rds/general/user/sho3/home/pbs_common.sh"
LOG_DIR="${PROJECT_DIR}/job_out"
JOB_NAME="${PBS_JOBNAME:-baseline_report}"
JOB_ID="${PBS_JOBID:-local}"
LIVE_LOG="${LOG_DIR}/${JOB_NAME}.${JOB_ID}.live.log"
REPORT_DIR="${REPORT_DIR:-${OUTPUT_DIR}/reports/${REPORT}/${JOB_ID}}"

#######################################
# Print and run one workflow stage.
# Arguments:
#   $1: Human-readable stage name.
#   Remaining arguments: Command and arguments to execute.
# Outputs:
#   Writes the stage name and shell-escaped command to stdout.
# Returns:
#   The executed command's exit status.
#######################################
run_stage() {
  local stage_name="$1"
  shift

  printf '\nStage: %s\n' "${stage_name}"
  printf 'Command:'
  printf ' %q' "$@"
  printf '\n\n'
  "$@"
}

#######################################
# Validate inputs, activate the environment, and run the selected report.
# Outputs:
#   Writes job context and report output to stdout and stderr.
# Returns:
#   0 on success; 2 for invalid job settings; otherwise the failing command's
#   exit status.
#######################################
main() {
  local command=()
  local config_path="${CONFIG_PATH}"
  local job_tmp="${TMPDIR:-/tmp}/${USER}/add_${JOB_ID}"

  case "${REPORT}" in
    transition)
      config_path="${config_path:-${REPO_DIR}/config/adipose_benchmark.yaml}"
      command=(
        python -u -m run_scripts.baselines.evaluate_adipose_transition
        --pseudobulk "${PSEUDOBULK_PATH}"
      )
      if [[ ! -f "${PSEUDOBULK_PATH}" ]]; then
        printf 'ERROR: pseudobulk input does not exist: %s\n' \
          "${PSEUDOBULK_PATH}" >&2
        return 2
      fi
      ;;
    panel)
      config_path="${config_path:-${REPO_DIR}/config/adipose_validation.yaml}"
      command=(python -u -m run_scripts.baselines.validate_adipose_panel)
      ;;
    perturbgen)
      config_path="${config_path:-${REPO_DIR}/config/perturbgen_visualization.yaml}"
      command=(python -u -m run_scripts.perturbgen.plot_perturbation)
      ;;
    programs)
      config_path="${config_path:-${REPO_DIR}/config/rescue_programs.yaml}"
      command=(python -u -m run_scripts.baselines.decompose_rescue_programs)
      ;;
    *)
      printf 'ERROR: submit with REPORT=transition, panel, perturbgen, or programs; got %s\n' \
        "${REPORT:-nothing}" >&2
      return 2
      ;;
  esac
  command+=(--config "${config_path}" --output-dir "${REPORT_DIR}")
  if [[ "${DRY_RUN}" == "1" ]]; then
    command+=(--dry-run)
  elif [[ "${DRY_RUN}" != "0" ]]; then
    printf 'ERROR: DRY_RUN must be 0 or 1, got %s\n' "${DRY_RUN}" >&2
    return 2
  fi

  if [[ ! -d "${REPO_DIR}" ]]; then
    printf 'ERROR: repository directory does not exist: %s\n' \
      "${REPO_DIR}" >&2
    return 2
  fi
  if [[ "${config_path}" != /* ]]; then
    printf 'ERROR: CONFIG_PATH must be absolute, got: %s\n' \
      "${config_path}" >&2
    return 2
  fi
  if [[ ! -f "${config_path}" ]]; then
    printf 'ERROR: report config does not exist: %s\n' "${config_path}" >&2
    return 2
  fi
  if [[ ! -d "${CONDA_ENV}" ]]; then
    printf 'ERROR: Conda environment does not exist: %s\n' \
      "${CONDA_ENV}" >&2
    return 2
  fi
  if [[ ! -f "${PBS_COMMON}" ]]; then
    printf 'ERROR: PBS helper does not exist: %s\n' "${PBS_COMMON}" >&2
    return 2
  fi

  mkdir -p "${LOG_DIR}" "${job_tmp}/matplotlib"
  source "${PBS_COMMON}"
  pbs::setup_logging "${LIVE_LOG}"
  pbs::activate_conda_environment "${CONDA_BASE}" "${CONDA_ENV}"
  pbs::log_job_context "${JOB_ID}" "${PROJECT_DIR}" "${LIVE_LOG}"

  if ! python -c 'import add' 2>/dev/null; then
    printf 'ERROR: the add package is not installed in %s\n' \
      "${CONDA_ENV}" >&2
    return 2
  fi

  cd "${REPO_DIR}"
  export MPLCONFIGDIR="${job_tmp}/matplotlib"
  export PYTHONUNBUFFERED=1

  printf 'Report: %s\n' "${REPORT}"
  printf 'Config: %s\n' "${config_path}"
  printf 'Report directory: %s\n' "${REPORT_DIR}"
  run_stage "run ${REPORT} report" "${command[@]}"
  printf '\nJob finished: %s\n' "$(date -Is)"
}

main "$@"
