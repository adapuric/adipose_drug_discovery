#!/bin/bash
#PBS -N perturbgen_inference
#PBS -l select=1:ncpus=16:mem=64gb:ngpus=1:gpu_type=A100
#PBS -l walltime=23:59:59
#PBS -q hx
#PBS -m a
#PBS -j oe
#PBS -o /gpfs/home/ap5625/add/job_out
#PBS -W umask=0002

# Run one PerturbGen gene perturbation and donor-aware descriptive summary.
#
# Submit after decoder training finishes:
#   qsub \
#     -v DECODER_CHECKPOINT=/path/to/decoder.ckpt,PERTURBATION_GENE=ENSG... \
#     run_scripts/perturbgen/run_perturbation.pbs

set -o errexit
set -o nounset
set -o pipefail
umask 0002

# Paths
ROOT="/gpfs/home/ap5625"
PROJECT_DIR="${ROOT}/add"
REPO_DIR="${PROJECT_DIR}/adipose_drug_discovery"
CONFIG_PATH="${CONFIG_PATH:-${REPO_DIR}/run_scripts/perturbgen/config.yaml}"

# Conda and modules
CONDA_BASE="${ROOT}/miniforge3"
CONDA_ENV="${CONDA_BASE}/envs/perturbgen"
OPENMPI_MODULE="${OPENMPI_MODULE:-OpenMPI/4.1.6-GCC-13.2.0}"

# qsub -v parameters
DECODER_CHECKPOINT="${DECODER_CHECKPOINT:-}"
PERTURBATION_GENE="${PERTURBATION_GENE:-}"

# PBS logging
PBS_COMMON="/gpfs/home/sho3/pbs_common.sh"
LOG_DIR="${PROJECT_DIR}/job_out"
JOB_NAME="${PBS_JOBNAME:-perturbgen_inference}"
JOB_ID="${PBS_JOBID:-local}"
LIVE_LOG="${LOG_DIR}/${JOB_NAME}.${JOB_ID}.live.log"

#######################################
# Print and run one workflow stage.
# Arguments:
#   $1: Human-readable stage name.
#   Remaining arguments: Command and arguments to execute.
# Outputs:
#   Writes the stage name and shell-escaped command to stdout.
# Returns:
#   The executed command's exit status.
#######################################
run_stage() {
  local stage_name="$1"
  shift

  printf '\nStage: %s\n' "${stage_name}"
  printf 'Command:'
  printf ' %q' "$@"
  printf '\n\n'
  "$@"
}

#######################################
# Validate settings, activate PerturbGen, and run perturbation inference.
# Outputs:
#   Writes job context, inference output, and summary paths to stdout/stderr.
# Returns:
#   0 on success; 2 for invalid job settings; otherwise the failing command's
#   exit status.
#######################################
main() {
  local command=()

  if [[ ! -d "${REPO_DIR}" ]]; then
    printf 'ERROR: repository directory does not exist: %s\n' \
      "${REPO_DIR}" >&2
    return 2
  fi
  if [[ "${CONFIG_PATH}" != /* ]]; then
    printf 'ERROR: CONFIG_PATH must be absolute, got: %s\n' \
      "${CONFIG_PATH}" >&2
    return 2
  fi
  if [[ ! -f "${CONFIG_PATH}" ]]; then
    printf 'ERROR: PerturbGen config does not exist: %s\n' \
      "${CONFIG_PATH}" >&2
    return 2
  fi
  if [[ ! -d "${CONDA_ENV}" ]]; then
    printf 'ERROR: PerturbGen Conda environment does not exist: %s\n' \
      "${CONDA_ENV}" >&2
    return 2
  fi
  if [[ -z "${DECODER_CHECKPOINT}" ]]; then
    printf 'ERROR: submit with DECODER_CHECKPOINT=/path/to/decoder.ckpt\n' \
      >&2
    return 2
  fi
  if [[ ! -f "${DECODER_CHECKPOINT}" ]]; then
    printf 'ERROR: decoder checkpoint does not exist: %s\n' \
      "${DECODER_CHECKPOINT}" >&2
    return 2
  fi
  if [[ ! -f "${PBS_COMMON}" ]]; then
    printf 'ERROR: PBS helper does not exist: %s\n' "${PBS_COMMON}" >&2
    return 2
  fi

  command=(
    python -u -m run_scripts.perturbgen.run_perturbation
    --config "${CONFIG_PATH}"
    --checkpoint "${DECODER_CHECKPOINT}"
  )
  if [[ -n "${PERTURBATION_GENE}" ]]; then
    command+=(--gene "${PERTURBATION_GENE}")
  fi

  mkdir -p "${LOG_DIR}"
  source "${PBS_COMMON}"
  pbs::setup_logging "${LIVE_LOG}"
  pbs::activate_conda_environment "${CONDA_BASE}" "${CONDA_ENV}"
  pbs::log_job_context "${JOB_ID}" "${PROJECT_DIR}" "${LIVE_LOG}"

  module load "${OPENMPI_MODULE}"
  cd "${REPO_DIR}"
  export PYTHONUNBUFFERED=1
  export WANDB_MODE="${WANDB_MODE:-offline}"

  printf 'Config: %s\n' "${CONFIG_PATH}"
  printf 'Decoder checkpoint: %s\n' "${DECODER_CHECKPOINT}"
  if [[ -n "${PERTURBATION_GENE}" ]]; then
    printf 'Perturbation gene: %s\n' "${PERTURBATION_GENE}"
  else
    printf 'Perturbation genes: from config\n'
  fi
  printf 'W&B mode: %s\n' "${WANDB_MODE}"
  run_stage "run and summarize PerturbGen inference" "${command[@]}"
  printf '\nJob finished: %s\n' "$(date -Is)"
}

main "$@"
