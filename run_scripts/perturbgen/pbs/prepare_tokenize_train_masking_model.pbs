#!/bin/bash
#PBS -N prepare_tokenize_train_masking
#PBS -l select=1:ncpus=8:mem=128gb:ngpus=1:gpu_type=A100
#PBS -l walltime=10:00:00
#PBS -q hx
#PBS -m a
#PBS -j oe
#PBS -o /gpfs/home/ap5625/add/job_out
#PBS -W umask=0002

# Prepare and tokenize the configured H5AD, then train the PerturbGen masking
# model.
#
# Submit from the repository root with a workflow config:
#   qsub -v CONFIG_PATH=/path/to/config.yaml \
#     run_scripts/perturbgen/pbs/prepare_tokenize_train_masking_model.pbs
#
# STAGES selects stages (colon-separated; they always run in workflow order).
# A config without a prepare section tokenizes tokenize.input_h5ad_path.
# Command-line -l options override the resource directives above:
#   qsub -l walltime=72:00:00 \
#     -v CONFIG_PATH=/path/to/config.yaml,STAGES=tokenize:masking \
#     run_scripts/perturbgen/pbs/prepare_tokenize_train_masking_model.pbs

set -o errexit
set -o nounset
set -o pipefail
umask 0002

# Paths
ROOT="/gpfs/home/ap5625"
PROJECT_DIR="${ROOT}/add"
REPO_DIR="${PROJECT_DIR}/adipose_drug_discovery"
CONFIG_PATH="${CONFIG_PATH:-${REPO_DIR}/run_scripts/perturbgen/configs/config.yaml}"

# Workflow
STAGES="${STAGES:-prepare:tokenize:masking}"

# Conda and modules
CONDA_BASE="${ROOT}/miniforge3"
CONDA_ENV="${CONDA_BASE}/envs/perturbgen"
OPENMPI_MODULE="${OPENMPI_MODULE:-OpenMPI/4.1.6-GCC-13.2.0}"

# PBS logging
PBS_COMMON="/gpfs/home/sho3/pbs_common.sh"
LOG_DIR="${PROJECT_DIR}/job_out"
JOB_NAME="${PBS_JOBNAME:-prepare_tokenize_train_masking}"
JOB_ID="${PBS_JOBID:-local}"
LIVE_LOG="${LOG_DIR}/${JOB_NAME}.${JOB_ID}.live.log"

#######################################
# Print and run one workflow stage.
# Arguments:
#   $1: Human-readable stage name.
#   Remaining arguments: Command and arguments to execute.
# Outputs:
#   Writes the stage name and shell-escaped command to stdout.
# Returns:
#   The executed command's exit status.
#######################################
run_stage() {
  local stage_name="$1"
  shift

  printf '\nStage: %s\n' "${stage_name}"
  printf 'Command:'
  printf ' %q' "$@"
  printf '\n\n'
  "$@"
}

#######################################
# Report whether a stage appears in a colon-separated stage selection.
# Arguments:
#   $1: Colon-separated stage selection.
#   $2: Stage name.
# Returns:
#   0 when the stage is selected; 1 otherwise.
#######################################
stage_selected() {
  [[ ":$1:" == *":$2:"* ]]
}

#######################################
# Validate settings, activate PerturbGen, and run the selected stages.
# Outputs:
#   Writes job context and workflow output to stdout and stderr.
# Returns:
#   0 on success; 2 for invalid job settings; otherwise the failing command's
#   exit status.
#######################################
main() {
  local prepare_command=(
    python -u -m run_scripts.perturbgen.prepare_adipose
    --config "${CONFIG_PATH}"
  )
  local tokenize_command=(
    python -u -m run_scripts.perturbgen.tokenize
    --config "${CONFIG_PATH}"
  )
  local masking_command=(
    python -u -m run_scripts.perturbgen.train_masking
    --config "${CONFIG_PATH}"
  )
  local stage
  local -a requested_stages

  IFS=':' read -r -a requested_stages <<< "${STAGES}"
  for stage in "${requested_stages[@]}"; do
    case "${stage}" in
      prepare | tokenize | masking) ;;
      *)
        printf 'ERROR: unknown stage %q in STAGES=%s; use prepare, tokenize, or masking\n' \
          "${stage}" "${STAGES}" >&2
        return 2
        ;;
    esac
  done

  if [[ ! -d "${REPO_DIR}" ]]; then
    printf 'ERROR: repository directory does not exist: %s\n' \
      "${REPO_DIR}" >&2
    return 2
  fi
  if [[ "${CONFIG_PATH}" != /* ]]; then
    printf 'ERROR: CONFIG_PATH must be absolute, got: %s\n' \
      "${CONFIG_PATH}" >&2
    return 2
  fi
  if [[ ! -f "${CONFIG_PATH}" ]]; then
    printf 'ERROR: PerturbGen config does not exist: %s\n' \
      "${CONFIG_PATH}" >&2
    return 2
  fi
  if [[ ! -d "${CONDA_ENV}" ]]; then
    printf 'ERROR: PerturbGen Conda environment does not exist: %s\n' \
      "${CONDA_ENV}" >&2
    return 2
  fi
  if [[ ! -f "${PBS_COMMON}" ]]; then
    printf 'ERROR: PBS helper does not exist: %s\n' "${PBS_COMMON}" >&2
    return 2
  fi

  mkdir -p "${LOG_DIR}"
  source "${PBS_COMMON}"
  pbs::setup_logging "${LIVE_LOG}"
  pbs::activate_conda_environment "${CONDA_BASE}" "${CONDA_ENV}"
  pbs::log_job_context "${JOB_ID}" "${PROJECT_DIR}" "${LIVE_LOG}"

  module load "${OPENMPI_MODULE}"
  cd "${REPO_DIR}"
  export PYTHONUNBUFFERED=1
  export WANDB_MODE="${WANDB_MODE:-offline}"

  printf 'Config: %s\n' "${CONFIG_PATH}"
  printf 'Stages: %s\n' "${STAGES}"
  printf 'W&B mode: %s\n' "${WANDB_MODE}"
  if stage_selected "${STAGES}" prepare; then
    run_stage "prepare paired adipocytes" "${prepare_command[@]}"
  fi
  if stage_selected "${STAGES}" tokenize; then
    run_stage "tokenize" "${tokenize_command[@]}"
  fi
  if stage_selected "${STAGES}" masking; then
    run_stage "train PerturbGen masking model" "${masking_command[@]}"
  fi

  printf '\nJob finished: %s\n' "$(date -Is)"
}

main "$@"
