#!/bin/bash
#PBS -N LPS_tokenize_train_masking
#PBS -l select=1:ncpus=16:mem=256gb:ngpus=1:gpu_type=A100
#PBS -l walltime=72:00:00
#PBS -q hx
#PBS -m a
#PBS -j oe
#PBS -o /gpfs/home/ap5625/add/job_out
#PBS -W umask=0002

# Tokenize an already-prepared H5AD (no prepare stage), then train the
# PerturbGen masking model. The input H5AD must already exist at the
# config's output_h5ad_path.
#
#   qsub -v CONFIG_PATH=/path/to/config.yaml \
#     run_scripts/perturbgen/pbs/LPS_tokenize_train_masking_model.pbs

set -o errexit
set -o nounset
set -o pipefail
umask 0002

# Paths
ROOT="/gpfs/home/ap5625"
PROJECT_DIR="${ROOT}/add"
REPO_DIR="${PROJECT_DIR}/adipose_drug_discovery"
CONFIG_PATH="${CONFIG_PATH:-${REPO_DIR}/run_scripts/perturbgen/configs/config_LPS_reproducing.yaml}"

# Conda and modules
CONDA_BASE="${ROOT}/miniforge3"
CONDA_ENV="${CONDA_BASE}/envs/perturbgen"
OPENMPI_MODULE="${OPENMPI_MODULE:-OpenMPI/4.1.6-GCC-13.2.0}"

# PBS logging
PBS_COMMON="/gpfs/home/sho3/pbs_common.sh"
LOG_DIR="${PROJECT_DIR}/job_out"
JOB_NAME="${PBS_JOBNAME:-LPS_tokenize_train_masking}"
JOB_ID="${PBS_JOBID:-local}"
LIVE_LOG="${LOG_DIR}/${JOB_NAME}.${JOB_ID}.live.log"

run_stage() {
  local stage_name="$1"
  shift
  printf '\nStage: %s (start %s)\n' "${stage_name}" "$(date -Is)"
  printf 'Command:'
  printf ' %q' "$@"
  printf '\n\n'
  "$@"
  printf '\nStage done: %s (end %s)\n' "${stage_name}" "$(date -Is)"
}

main() {
  local tokenize_command=(
    python -u -m run_scripts.perturbgen.tokenize
    --config "${CONFIG_PATH}"
  )
  local masking_command=(
    python -u -m run_scripts.perturbgen.train_masking
    --config "${CONFIG_PATH}"
  )

  if [[ ! -d "${REPO_DIR}" ]]; then
    printf 'ERROR: repository directory does not exist: %s\n' "${REPO_DIR}" >&2
    return 2
  fi
  if [[ "${CONFIG_PATH}" != /* ]]; then
    printf 'ERROR: CONFIG_PATH must be absolute, got: %s\n' "${CONFIG_PATH}" >&2
    return 2
  fi
  if [[ ! -f "${CONFIG_PATH}" ]]; then
    printf 'ERROR: PerturbGen config does not exist: %s\n' "${CONFIG_PATH}" >&2
    return 2
  fi
  if [[ ! -d "${CONDA_ENV}" ]]; then
    printf 'ERROR: PerturbGen Conda environment does not exist: %s\n' "${CONDA_ENV}" >&2
    return 2
  fi
  if [[ ! -f "${PBS_COMMON}" ]]; then
    printf 'ERROR: PBS helper does not exist: %s\n' "${PBS_COMMON}" >&2
    return 2
  fi

  mkdir -p "${LOG_DIR}"
  source "${PBS_COMMON}"
  pbs::setup_logging "${LIVE_LOG}"
  pbs::activate_conda_environment "${CONDA_BASE}" "${CONDA_ENV}"
  pbs::log_job_context "${JOB_ID}" "${PROJECT_DIR}" "${LIVE_LOG}"

  module load "${OPENMPI_MODULE}"
  cd "${REPO_DIR}"
  export PYTHONUNBUFFERED=1
  export WANDB_MODE="${WANDB_MODE:-offline}"

  printf 'Config: %s\n' "${CONFIG_PATH}"
  printf 'W&B mode: %s\n' "${WANDB_MODE}"
  printf 'Skipping prepare: using the existing H5AD at the config output path.\n'

  run_stage "tokenize" "${tokenize_command[@]}"
  run_stage "train PerturbGen masking model" "${masking_command[@]}"

  printf '\nJob finished: %s\n' "$(date -Is)"
}

main "$@"
