#!/bin/bash
#PBS -N prepare_tokenize_adipose
#PBS -l select=1:ncpus=18:mem=128gb
#PBS -l walltime=24:00:00
#PBS -m a
#PBS -j oe
#PBS -o /rds/general/user/sho3/projects/lms-scott-raw/live/steve/add/job_out

# Prepare the paired adipocyte H5AD and tokenize it for PerturbGen.
#
# Submit from the repository root:
#   qsub run_scripts/perturbgen/pbs/prepare_and_tokenize.pbs

set -o errexit
set -o nounset
set -o pipefail

# Paths
ROOT="/rds/general/user/sho3/projects/lms-scott-raw/live/steve"
PROJECT_DIR="${ROOT}/add"
REPO_DIR="${PROJECT_DIR}/adipose_drug_discovery"
CONFIG_PATH="${CONFIG_PATH:-${REPO_DIR}/run_scripts/perturbgen/config.yaml}"
RESULTS_DIR="${PROJECT_DIR}/pg_results"
NATIVE_OUTPUT_DIR="${PROJECT_DIR}/T_perturb"

# Conda
CONDA_BASE="${ROOT}/software/conda/base"
CONDA_ENV="${ROOT}/software/envs/perturbgen"

# PBS logging
PBS_COMMON="/rds/general/user/sho3/home/pbs_common.sh"
LOG_DIR="${PROJECT_DIR}/job_out"
JOB_NAME="${PBS_JOBNAME:-prepare_tokenize_adipose}"
JOB_ID="${PBS_JOBID:-local}"
LIVE_LOG="${LOG_DIR}/${JOB_NAME}.${JOB_ID}.live.log"

#######################################
# Print and run one workflow stage.
# Arguments:
#   $1: Human-readable stage name.
#   Remaining arguments: Command and arguments to execute.
# Outputs:
#   Writes the stage name and shell-escaped command to stdout.
# Returns:
#   The executed command's exit status.
#######################################
run_stage() {
  local stage_name="$1"
  shift

  printf 'Stage: %s\n' "${stage_name}"
  printf 'Command:'
  printf ' %q' "$@"
  printf '\n'
  "$@"
}

#######################################
# Validate settings, activate PerturbGen, and run preparation and tokenization.
# Outputs:
#   Writes job context and workflow output to stdout and stderr.
# Returns:
#   0 on success; 2 for invalid job settings; otherwise the failing command's
#   exit status.
#######################################
main() {
  local prepare_command=(
    python -u -m run_scripts.perturbgen.prepare_adipose
    --config "${CONFIG_PATH}"
  )
  local tokenize_command=(
    python -u -m run_scripts.perturbgen.tokenize
    --config "${CONFIG_PATH}"
  )

  mkdir -p "${RESULTS_DIR}" "${NATIVE_OUTPUT_DIR}" "${LOG_DIR}"

  if [[ ! -d "${REPO_DIR}" ]]; then
    printf 'ERROR: repository directory does not exist: %s\n' \
      "${REPO_DIR}" >&2
    return 2
  fi
  if [[ ! -f "${CONFIG_PATH}" ]]; then
    printf 'ERROR: PerturbGen config does not exist: %s\n' \
      "${CONFIG_PATH}" >&2
    return 2
  fi
  if [[ ! -f "${PBS_COMMON}" ]]; then
    printf 'ERROR: PBS helper does not exist: %s\n' "${PBS_COMMON}" >&2
    return 2
  fi

  source "${PBS_COMMON}"
  pbs::setup_logging "${LIVE_LOG}"
  pbs::activate_conda_environment "${CONDA_BASE}" "${CONDA_ENV}"
  pbs::log_job_context "${JOB_ID}" "${PROJECT_DIR}" "${LIVE_LOG}"

  cd "${REPO_DIR}"
  export PYTHONUNBUFFERED=1

  printf 'Config: %s\n' "${CONFIG_PATH}"
  printf 'Results root: %s\n' "${RESULTS_DIR}"
  printf 'Native PerturbGen output: %s\n' "${NATIVE_OUTPUT_DIR}"
  run_stage "prepare paired adipocytes" "${prepare_command[@]}"
  run_stage "tokenize paired adipocytes" "${tokenize_command[@]}"

  printf 'Job finished: %s\n' "$(date -Is)"
}

main "$@"
